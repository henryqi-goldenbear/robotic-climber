LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_ROOM=himalaya
LIVEKIT_ROBOT_IDENTITY=robot
LIVEKIT_OPERATOR_IDENTITY=operator

# Local development with compose.livekit.yml / `livekit-server --dev`.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# For LiveKit Cloud or a production deployment, replace the URL above and
# prefer separately minted, least-privilege tokens on deployed devices.
# LIVEKIT_TOKEN=robot-participant-token
# LIVEKIT_OPERATOR_TOKEN=operator-participant-token
#
# For trusted development machines only, the clients can mint tokens when the
# role-specific token is omitted.
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret
